# ---- copy to .env for local dev; in Cloud Run set these as env vars / secrets ----

# GCP / BigQuery
GCP_PROJECT=jason-capital
BQ_DATASET=jc_scoreboard
# Use the plain 'transactions' view (Drive-free). NOT 'transactions_enriched' —
# that view joins Drive-backed Sheets and requires Drive credentials.
BQ_TABLE=transactions
REFUND_WINDOW_DAYS=7

# CORS — must exactly match the SamCart page origin
ALLOWED_ORIGIN=https://ammarketing.mysamcart.com

# Auth for the short-lived refund token (generate: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_long_random_hex

# SamCart API (key issued by support@samcart.com — private beta)
SAMCART_MARKETPLACE=ammarketing          # -> https://ammarketing.samcart.com/v1
SAMCART_API_KEY=CHANGE_ME_sc_api_key

# OTP email delivery (Resend). MAIL_FROM must be on a Resend-verified domain (aircreator.cloud).
RESEND_API_KEY=CHANGE_ME_resend_key
RESEND_TEMPLATE_ID=jc-refund-otp
MAIL_FROM=Jason Capital Refunds <no-reply@otp.joinaffiliateboss.com>

# OTP behaviour
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
